@startuml uc_tongquan
left to right direction
skinparam packageStyle rectangle

actor "Khách Hàng Vãng Lai" as KHVL
actor "Khách Hàng" as KH 
actor "Người Dùng" as ND
actor "Nhân Viên" as NV
actor Admin as AD

ND <|-- AD
ND <|-- NV
ND <|-- KH

rectangle "Hệ Thống" {
  ND --> (Đăng nhập)
  ND --> (Thay đổi mật khẩu)
  (Đăng nhập) <.. (Đăng xuất) : <<extends>>
  (Thanh toán) ..> (Đăng nhập) : <<includes>>

  KHVL --> (Đăng ký)
  KHVL --> (Tìm kiếm sách)

  KH --> (Tìm kiếm sách)
  KH --> (Quản lý giỏ hàng)
  KH --> (Quản lý đơn hàng - User)
  KH --> (Thanh toán)

  (Thanh toán) ..> (Đặt hàng) : <<includes>>
  (Đăng nhập) <.. (Đánh giá) : <<includes>>

  AD --> (Quản lý đơn hàng - Staff)
  AD --> (Quản lý người dùng)
  AD --> (Thống kê bán hàng)
  AD --> (Quản lý sách)
  AD --> (Quản lý mã giảm giá)
  AD --> (Quản lý danh mục sách)

  NV --> (Quản lý đơn hàng - Staff)
}

@enduml