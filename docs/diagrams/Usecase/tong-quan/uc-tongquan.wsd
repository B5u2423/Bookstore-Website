@startuml uc-tongquan
left to right direction
skinparam packageStyle rectangle

actor "Khách Hàng" as KH
actor "Người Dùng" as ND
actor "Quản Lý" as QL
actor "Nhân Viên" as NV
actor Admin as AD

ND <|-- AD
ND <|-- QL
ND <|-- KH
ND <|-- NV

rectangle "Hệ Thống" {
  ND --> (Đăng nhập)
  ND --> (Thay đổi mật khẩu)
  (Đăng nhập) <.. (Đăng xuất) : <<extends>>
  ND --> (Xem thông tin người dùng)
  (Xem thông tin người dùng) <.. (Thay đổi thông tin) : <<extends>>
  (Thanh toán) ..> (Đăng nhập) : <<includes>>

  KH --> (Đăng ký)
  KH --> (Tìm kiếm sản phẩm)
  KH --> (Quản lý giỏ hàng)
  KH --> (Quản lý đơn hàng - User)
  KH --> (Thanh toán)

  (Quản lý đơn hàng - User) <.. (Hủy đơn)  : <<extends>>
  (Quản lý đơn hàng - User) <.. (Xem chi tiết) : <<extends>>
  (Thanh toán) ..> (Đặt hàng) : <<includes>>
  (Đặt hàng) <.. (Thêm vào giỏ hàng) : <<includes>>
  (Đặt hàng) <.. (Đánh giá) : <<includes>>
  (Quản lý giỏ hàng) <.. (Thêm sản phẩm vào giỏ) : <<extends>>
  (Quản lý giỏ hàng) <.. (Xóa sản phẩm trong giỏ) : <<extends>>
  (Quản lý giỏ hàng) <.. (Thay đổi số lượng) : <<extends>>

  AD --> (Quản lý đơn hàng - Staff)
  AD --> (Quản lý người dùng)
  AD --> (Thống kê bán hàng)
  AD --> (Quản lý sản phẩm)
  AD --> (Quản lý sự kiện giảm giá)

  (Quản lý người dùng) <.. (Xem chi tiết người dùng) : <<extends>>
  (Quản lý người dùng) <.. (Xóa người dùng) : <<extends>>
  (Quản lý sản phẩm) <.. (Thêm sản phẩm) : <<extends>>
  (Quản lý sản phẩm) <.. (Chỉnh sửa sản phẩm) : <<extends>>
  (Quản lý sản phẩm) <.. (Ẩn sản phẩm) : <<extends>>
  (Quản lý sản phẩm) <.. (Xóa sản phẩm) : <<extends>>

  QL --> (Quản lý đơn hàng - Staff)
  (Quản lý đơn hàng - Staff) <.. (Xem chi tiết đơn hàng) : <<extends>>
  (Quản lý đơn hàng - Staff) <.. (Hủy đơn hàng) : <<extends>>
  (Quản lý đơn hàng - Staff) <.. (Thay đổi trạng thái đơn hàng) : <<extends>>
  
  
}

@enduml