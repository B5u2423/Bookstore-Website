@startuml act_checkout
skinparam ArrowColor #4a4a4a
skinparam ActivityBorderColor #4a4a4a
skinparam ActivityBackgroundColor #f9f9f9
skinparam ActivityDiamondBackgroundColor #fff8e1
skinparam ActivityDiamondBorderColor #4a4a4a
skinparam shadowing false
skinparam defaultFontSize 13

title Luồng Thanh Toán (Checkout)

|Khách hàng / Frontend|
start
:Xem giỏ hàng, nhập địa chỉ\nchọn phương thức thanh toán;

note right
  <b>Giai đoạn 1:</b> Tạo đơn hàng
end note

:POST /api/v1/orders/create-order\n(Bearer token);

|OrderService / CartService|
:Lấy thông tin giỏ hàng\n(SELECT giỏ hàng + sản phẩm);

|PostgreSQL|
:Trả dữ liệu giỏ hàng;

|OrderService / CartService|
:Tính tổng tiền, phí vận chuyển\náp mã giảm giá (nếu có);
:Lưu đơn hàng + item + địa chỉ\n(INSERT orders, order_items);

|PostgreSQL|
:Xác nhận lưu thành công\n(trả về id);

|OrderService / CartService|
:Trả CreatedOrder\n(orderId, total);

|Khách hàng / Frontend|
:Nhận 201 Created\n(orderId + tổng tiền);

note right
  <b>Giai đoạn 2:</b> Tạo thông tin thanh toán VNPAY
end note

:POST /api/v1/payment/create-payment\n(Bearer token);

|VnPayService / PaymentController|
:Tạo thông tin thanh toán\n(tổng số tiền, mã đơn hàng);
:Lưu giao dịch trạng thái pending;

|PostgreSQL|
:Xác nhận lưu giao dịch;

|VnPayService / PaymentController|
:Tạo paymentUrl VNPAY;
:Trả 200 OK + paymentUrl;

|Khách hàng / Frontend|
:Chuyển hướng sang cổng VNPAY;

note right
  <b>Giai đoạn 3:</b> Callback từ VNPAY
end note

|VnPayService / PaymentController|
:Nhận GET /payment/callback?params\ntừ cổng VNPAY;
:verifyCallback(params);
:Cập nhật trạng thái giao dịch\n(success / fail);

if (Thanh toán thành công?) then (Có)
  :Cập nhật trạng thái đơn hàng = PAID\n(UPDATE orders);

  |PostgreSQL|
  :Xác nhận cập nhật;

  |VnPayService / PaymentController|
  :302 Redirect về trang thành công;

  |Khách hàng / Frontend|
  :Điều hướng "/orders"\nHiển thị thông báo thành công;
  stop
else (Không)
  :302 Redirect về trang thất bại;

  |Khách hàng / Frontend|
  :Hiển thị lỗi thanh toán;
  stop
endif

@enduml