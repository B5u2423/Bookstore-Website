@startuml
skinparam ArrowColor #4a4a4a
skinparam ActivityBorderColor #4a4a4a
skinparam ActivityBackgroundColor #f9f9f9
skinparam shadowing false

Title Luồng Đăng Ký (Tạo Tài Khoản)

|Khách hàng|
start
:Nhập tên, email, mật khẩu, loại người dùng;

|FrontEnd (Màn hình đăng ký)|
:Kiểm tra form;
if (Form hợp lệ?) then (không)
  :Hiển thị thông báo lỗi;
  stop
else (có)
endif
:POST /api/v1/auth/register;

|AuthenticationController|
:Nhận yêu cầu đăng ký;
:Chuyển thông tin (email, mật khẩu) tới dịch vụ;

|AuthService|
:Kiểm tra email đã đăng ký?;

|UserRepository|
:Tìm người dùng theo email;

|AuthService|
if (Email đã tồn tại?) then (có)
  |AuthenticationController|
  :Trả về 409 Conflict;
  |FrontEnd (Màn hình đăng ký)|
  :Hiển thị thông báo lỗi;
  stop
else (không)
endif

|AuthService|
:Mã hóa mật khẩu;
:Lưu thông tin người dùng;

|UserRepository|
:Lưu người dùng;

|PostgreSQL|
:INSERT người dùng;\nTrả về id;

|AuthService|
:Trả về kết quả thành công;

|AuthenticationController|
:Trả về 201 Created;

|FrontEnd (Màn hình đăng ký)|
:Hiển thị thành công;
:Điều hướng /login;
stop

note right: Endpoint cho phép ẩn danh; JWT chỉ áp dụng cho endpoint bảo vệ.
@enduml
