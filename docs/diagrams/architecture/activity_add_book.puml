@startuml act_addbook
skinparam ArrowColor #4a4a4a
skinparam ActivityBorderColor #4a4a4a
skinparam ActivityBackgroundColor #f9f9f9
skinparam ActivityDiamondBackgroundColor #fff8e1
skinparam ActivityDiamondBorderColor #4a4a4a
skinparam shadowing false
skinparam defaultFontSize 13

title Thêm Sách Mới (Quản trị)

|Frontend|
start
:Điền form & chọn ảnh;

:Kiểm tra form thông tin;

if (Form hợp lệ?) then (Không)
  :Hiển thị thông báo lỗi;
  stop
else (Có)
endif

:POST /api/v1/books/add\n(multipart + Bearer token);

|BookController / BookService|
:Nhận yêu cầu thêm sách\n(thông tin + file ảnh);

|Cloudinary / PostgreSQL|
:Kiểm tra danh mục\n(SELECT từ PostgreSQL);

|BookController / BookService|
if (Danh mục tồn tại?) then (Không)
  :Trả về thông điệp lỗi;

  |Frontend|
  :Hiển thị thông báo lỗi\n400 / 404;
  stop
else (Có)
endif

|Cloudinary / PostgreSQL|
:Upload ảnh lên Cloudinary;
:Nhận URL ảnh;

|BookController / BookService|
:INSERT sách vào PostgreSQL\n(thông tin + URL ảnh);

|Cloudinary / PostgreSQL|
:Xác nhận thành công\n(trả về id mới);

|BookController / BookService|
:Trả về 201 Created;

|Frontend|
:Hiển thị thông báo thành công;
:Điều hướng về /admin/books;
stop

@enduml