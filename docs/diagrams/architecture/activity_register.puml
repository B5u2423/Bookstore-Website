@startuml act_register
skinparam ArrowColor #4a4a4a
skinparam ActivityBorderColor #4a4a4a
skinparam ActivityBackgroundColor #f9f9f9
skinparam ActivityDiamondBackgroundColor #fff8e1
skinparam ActivityDiamondBorderColor #4a4a4a
skinparam shadowing false
skinparam defaultFontSize 13

title Luồng Đăng Ký (Tạo Tài Khoản)

|Khách hàng / Frontend|
start
:Nhập tên, email, mật khẩu\nloại người dùng;
:Kiểm tra form;

if (Form hợp lệ?) then (Không)
  :Hiển thị thông báo lỗi\nở màn hình đăng ký;
  stop
else (Có)
endif

:POST /api/v1/auth/register\n(email, mật khẩu, thông tin);

|AuthService / UserRepository|
:Nhận yêu cầu đăng ký;
:Kiểm tra email đã tồn tại?\n(truy vấn PostgreSQL);

|PostgreSQL|
:Trả kết quả kiểm tra email;

|AuthService / UserRepository|
if (Email đã được đăng ký?) then (Có)
  :Trả kết quả lỗi;

  |Khách hàng / Frontend|
  :Nhận 409 Conflict;
  :Hiển thị thông báo lỗi\n(email đã tồn tại);
  stop
else (Không — email mới)
endif

:Mã hóa mật khẩu (bcrypt);
:Lưu thông tin người dùng\n(INSERT vào PostgreSQL);

|PostgreSQL|
:Xác nhận thành công\n(trả về id mới);

|AuthService / UserRepository|
:Trả kết quả thành công\ncho Controller;
:Phản hồi 201 Created;

|Khách hàng / Frontend|
:Hiển thị thông báo thành công;
:Điều hướng đến "/login";

note
  Endpoint /api/v1/auth/register cho phép truy cập ẩn danh.
  JWT chỉ áp dụng cho các endpoint cần định danh
  (admin / customer).
end note

stop

@enduml