@startuml
skinparam ArrowColor #4a4a4a
skinparam ActivityBorderColor #4a4a4a
skinparam ActivityBackgroundColor #f9f9f9
skinparam shadowing false

Title Thêm Sách Mới (Quản trị)


|Quản trị viên|
start
:Điền form và chọn ảnh;

|FrontEnd (Trang thêm sách - Admin)|
:Kiểm tra form thông tin;
if (Form hợp lệ?) then (không)
  :Hiển thị thông báo lỗi;
  stop
else (có)
endif
:POST /api/v1/books/add (multipart)\nAuthorization: Bearer <token>;

|BookController|
:Nhận yêu cầu thêm sách;

|BookService|
:Kiểm tra danh mục;

|PostgreSQL|
:Tìm danh mục theo id;

|BookService|
if (Danh mục hợp lệ?) then (không)
  |BookController|
  :Trả về 400/404 + thông điệp;
  |FrontEnd (Trang thêm sách - Admin)|
  :Hiển thị thông báo lỗi;
  stop
else (có)
endif

|BookService|
:Upload ảnh lên Cloudinary;

|CloudinaryService|
:Lưu ảnh;\nTrả về URL ảnh;

|BookService|
:Thêm sách (INSERT + URL ảnh);

|PostgreSQL|
:INSERT sách;\nTrả về id;

|BookController|
:Trả về 201 Created;

|FrontEnd (Trang thêm sách - Admin)|
:Hiển thị thành công;
:Điều hướng /admin/books;
stop

note right: Route ADMIN bảo vệ; JWT xác thực token và quyền.
@enduml