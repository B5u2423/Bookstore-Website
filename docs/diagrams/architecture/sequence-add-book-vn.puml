@startuml seq_add_book
skinparam ArrowColor #4a4a4a
skinparam ParticipantBorderColor #4a4a4a
skinparam ParticipantBackgroundColor #f9f9f9
skinparam sequenceArrowThickness 1
skinparam lifelineStrategy solid
skinparam shadowing false

title Thêm Sách Mới (Quản trị)

actor "Quản trị viên" as Admin
participant "FrontEnd\n(Trang thêm sách - Admin)" as FE
participant "BookController\n(/api/v1/books/add)" as Ctrl
participant "BookService" as Service
participant "CategoryRepository" as CategoryRepo
participant "BookRepository" as BookRepo
participant "CloudinaryService" as Cloudinary
database "PostgreSQL" as PG

Admin -> FE: Điền form và chọn ảnh
FE -> FE: Kiểm tra form thông tin
alt Form không hợp lệ
  FE --> Admin: Hiển thị thông báo lỗi
end

FE -> Ctrl: POST /api/v1/books/add (multipart)\nAuthorization: Bearer <token>
Ctrl -> Service: Thêm sách (thông tin sách + file ảnh)
Service -> CategoryRepo: Tìm thông tin danh mục
alt Không tìm thấy danh mục
  Service --> Ctrl: Trả về thông điệp lỗi
  Ctrl --> FE: 400/404 + thông điệp
  FE -> FE: Hiển thị thông báo lỗi
else Danh mục hợp lệ
  Service -> Cloudinary: Upload ảnh lên Cloudinary
  Cloudinary --> Service: URL ảnh
  Service -> BookRepo: Lưu thông tin sách + URL ảnh
  BookRepo -> PG: Thêm sách (INSERT)
  PG --> BookRepo: ok (id)
  BookRepo --> Service: Sách đã lưu
  Service --> Ctrl: Trả về kết quả đã tạo sách mới
  Ctrl --> FE: 201 Created
  FE -> FE: Hiển thị thành công; điều hướng "/admin/books"
end

FE --> User

@endum